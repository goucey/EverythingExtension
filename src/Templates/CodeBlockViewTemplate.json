{
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "wrap": true,
          "horizontalAlignment": "Center",
          "size": "Large"
        },
        {
          "type": "TextBlock",
          "language": "${language}",
          "wrap": true,
          "text": "${content}"
        }
       
      ]
    }
  ]
}